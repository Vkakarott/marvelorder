---
interface Props {
    href: string
}

const { href } = Astro.props
---

<a class="back-link" href={ href } data-back-link>Voltar</a>

<script>
    document.querySelectorAll<HTMLAnchorElement>( '[data-back-link]' ).forEach( link => {
        link.addEventListener( 'click', event => {
            if ( event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey ) {
                return
            }

            if ( document.referrer && new URL( document.referrer ).origin === window.location.origin && window.history.length > 1 ) {
                event.preventDefault()
                window.history.back()
            }
        } )
    } )
</script>

<style>
    .back-link {
        display: inline-flex;
        min-width: 6.75rem;
        min-height: 2.75rem;
        align-items: center;
        justify-content: center;
        padding: 0.65rem 1.2rem;
        border: 1px solid rgba(255, 255, 255, 0.18);
        border-radius: 0.8rem;
        background: linear-gradient(135deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0.04));
        box-shadow: inset 0 1px rgba(255, 255, 255, 0.1), 0 10px 24px rgba(0, 0, 0, 0.2);
        color: #fff;
        font-size: 0.875rem;
        font-weight: 700;
        letter-spacing: 0.01em;
        line-height: 1;
        text-decoration: none;
        backdrop-filter: blur(16px);
        transition: background 180ms ease, border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
    }

    .back-link:hover {
        transform: translateY(-2px);
        border-color: rgba(var(--title-accent-rgb), 0.75);
        background: linear-gradient(135deg, rgba(var(--title-accent-rgb), 0.28), rgba(255, 255, 255, 0.08));
        box-shadow: inset 0 1px rgba(255, 255, 255, 0.16), 0 14px 30px rgba(0, 0, 0, 0.28);
        color: #fff;
    }

    .back-link:focus-visible {
        outline: 2px solid var(--title-accent);
        outline-offset: 3px;
    }

    .back-link:active {
        transform: translateY(0);
    }

    @media (prefers-reduced-motion: reduce) {
        .back-link {
            transition: none;
        }
    }
</style>
