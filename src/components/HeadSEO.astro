---
import { SITE } from '../config'

export interface Props {
    content: any
    canonicalURL: URL | string
}

const { content = {}, canonicalURL } = Astro.props
const pageTitle = content.title ? `${ content.title } | ${ SITE.title }` : SITE.title
const description = content.description || SITE.description
const imageSrc = content.image?.src
const imageURL = imageSrc ? new URL( imageSrc, Astro.url ).toString() : undefined
const imageAlt = content.image?.alt || pageTitle
---

<link rel="canonical" href={canonicalURL} />

<meta name="description" content={description} />
<meta property="og:title" content={pageTitle} />
<meta property="og:type" content={content.type ?? 'website'} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:locale" content={content.ogLocale ?? SITE.defaultLanguage} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content={SITE.title} />
{imageURL && <meta property="og:image" content={imageURL} />}
{imageURL && <meta property="og:image:alt" content={imageAlt} />}

<meta name="twitter:card" content={imageURL ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
{imageURL && <meta name="twitter:image" content={imageURL} />}
{imageURL && <meta name="twitter:image:alt" content={imageAlt} />}
