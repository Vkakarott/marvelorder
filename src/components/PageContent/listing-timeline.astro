---
import { getTimelineFromJson } from '~/src/helpers/node/movies-fandom-timeline'

const { listing } = Astro.props
const timeline = await getTimelineFromJson()
const { entries } = timeline.getEntriesForListing( listing )

const monthAbbreviations: Record<string, string> = {
    January: 'jan.',
    February: 'fev.',
    March: 'mar.',
    April: 'abr.',
    May: 'mai.',
    June: 'jun.',
    July: 'jul.',
    August: 'ago.',
    September: 'set.',
    October: 'out.',
    November: 'nov.',
    December: 'dez.',
}

function formatTimelineDate ( parts ) {
    const day = parts.tertiary?.replace( /(\d+)(st|nd|rd|th)/, '$1' )
    const month = monthAbbreviations[ parts.secondary ] || parts.secondary
    return [ day, month, parts.primary ].filter( Boolean ).join( ' ' )
}
---

{ entries.length > 0 && (
    <section class="timeline-section" aria-labelledby="timeline-title">
        <h2 id="timeline-title">Cronologia do título</h2>
        <p>Eventos relacionados a este título na linha do tempo.</p>
        <details>
            <summary>Ver { entries.length } { entries.length === 1 ? 'evento' : 'eventos' }</summary>
            <ol>
                { entries.map( timelineEntry => (
                    <li>
                        <p class="timeline-date">{ formatTimelineDate( timelineEntry.timeDescriptionParts ) }</p>
                        <p class="timeline-text">{ timelineEntry.textContent }</p>
                        <div class="timeline-source">
                            <span>{ timelineEntry.timeline }</span>
                            <a href={ timelineEntry.sourceUrl } target="_blank" rel="noopener noreferrer">Fonte ↗</a>
                        </div>
                    </li>
                ) ) }
            </ol>
        </details>
    </section>
) }

<style>
    .timeline-section {
        margin-top: 3rem;
        padding-top: 2rem;
        border-top: 1px solid rgba(255, 255, 255, 0.12);
    }
    .timeline-section h2 {
        margin: 0 0 0.75rem;
        font-size: 1.5rem;
    }
    .timeline-section > p {
        color: #9ca3af;
    }
    details {
        margin-top: 1.5rem;
    }
    summary {
        width: fit-content;
        cursor: pointer;
        padding: 0.8rem 1rem;
        border: 1px solid rgba(255, 255, 255, 0.25);
        border-radius: 0.75rem;
        color: #f3f4f6;
        font-weight: 700;
    }
    summary:hover {
        background: rgba(255, 255, 255, 0.08);
    }
    ol {
        display: grid;
        gap: 1rem;
        margin: 1.5rem 0 0;
        padding: 0;
        list-style: none;
    }
    li {
        padding: 1.25rem;
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 0.75rem;
        background: rgba(255, 255, 255, 0.03);
    }
    .timeline-date {
        color: #fda4af;
        font-size: 0.8rem;
        font-weight: 800;
        text-transform: uppercase;
    }
    .timeline-text {
        margin-top: 0.75rem;
        color: #e5e7eb;
        line-height: 1.65;
        white-space: pre-line;
    }
    .timeline-source {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 0.5rem;
        margin-top: 1rem;
        color: #9ca3af;
        font-size: 0.75rem;
    }
    .timeline-source a {
        color: #d1d5db;
    }
</style>
