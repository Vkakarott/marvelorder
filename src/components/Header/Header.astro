---
import * as CONFIG from '../../config'
import SkipToContent from './SkipToContent.astro'

const currentPath = new URL( Astro.request.url ).pathname.replace( /\/$/, '' ) || '/'

const listingOptions = [
    {
        title: 'Todos os títulos',
        description: 'Explore filmes e séries da Marvel.',
        href: '/',
    },
    {
        title: 'Ordem cronológica do MCU',
        description: 'Acompanhe os acontecimentos na linha do tempo.',
        href: '/marvel-cinematic-universe-in-timeline-order',
    },
    {
        title: 'Ordem de lançamento do MCU',
        description: 'Veja os títulos na sequência de estreia.',
        href: '/marvel-cinematic-universe-movies-in-order',
    },
    {
        title: 'Saga do Infinito',
        description: 'Explore a primeira grande saga do MCU.',
        href: '/en/lists/infinity-saga',
    },
    {
        title: 'Saga do Multiverso',
        description: 'Explore a saga seguinte do MCU.',
        href: '/en/lists/multiverse-saga',
    },
]
---

<header class="fixed inset-x-0 top-0 z-top-nav px-4 py-5 sm:px-6 lg:px-8">
    <SkipToContent />

    <div class="flex items-center gap-6">
        <a href="/" class="font-medium text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white">
            { CONFIG.SITE.title }
        </a>

        <details id="listing-menu" class="listing-menu relative">
            <summary class="flex min-h-11 cursor-pointer list-none items-center gap-2 rounded-md px-3 text-white hover:bg-white/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">
                <span>Listagens</span>
                <svg class="h-4 w-4 text-gray-300 transition-transform" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
                </svg>
            </summary>

            <nav class="listing-menu-panel overflow-y-auto rounded-xl border border-white/20 bg-black/95 p-2 text-white shadow-2xl backdrop-blur-xl" aria-label="Escolher listagem">
                <ul class="space-y-1">
                    { listingOptions.map( ( option ) => (
                        <li>
                            <a
                                href={ option.href }
                                aria-current={ currentPath === option.href ? 'page' : undefined }
                                class="block rounded-lg px-3 py-2 hover:bg-white/10 focus-visible:bg-white/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-white"
                            >
                                <span class="block font-medium">{ option.title }</span>
                                <span class="block text-sm text-gray-300">{ option.description }</span>
                            </a>
                        </li>
                    ) ) }
                </ul>
            </nav>
        </details>
    </div>
</header>

<script>
    const listingMenu = document.querySelector<HTMLDetailsElement>( '#listing-menu' )

    if ( listingMenu ) {
        document.addEventListener( 'pointerdown', ( event ) => {
            if ( event.target instanceof Node && !listingMenu.contains( event.target ) ) {
                listingMenu.open = false
            }
        } )

        document.addEventListener( 'keydown', ( event ) => {
            if ( event.key === 'Escape' && listingMenu.open ) {
                listingMenu.open = false
                listingMenu.querySelector( 'summary' )?.focus()
            }
        } )
    }
</script>

<style>
    .listing-menu summary::-webkit-details-marker {
        display: none;
    }

    .listing-menu[open] summary svg {
        transform: rotate(180deg);
    }

    .listing-menu-panel {
        position: fixed;
        top: 4.75rem;
        left: 1rem;
        width: min(22rem, calc(100vw - 2rem));
        max-height: calc(100dvh - 5rem);
    }

    @media (min-width: 640px) {
        .listing-menu-panel {
            position: absolute;
            top: 100%;
            left: 0;
            margin-top: 0.5rem;
        }
    }
</style>
