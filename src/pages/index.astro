---
// @ts-ignore
import { convertNullValuesForAstro } from '~/src/helpers/listing'
// @ts-ignore
import { getHomepageListings } from '~/src/helpers/node/homepage-listings'

import Layout from '../layouts/HorizontalScroll.astro'
import ListingRow from '../components/listing-row.vue'
import { timelineStateStorageKey } from '~/src/helpers/timeline-state'
import { buildCharacterTimelineIndex } from '~/src/helpers/character-links'
import type { CharacterRegistry } from '~/src/helpers/character-links'
import type { CharacterSnapshot } from '~/src/helpers/characters'
import characterRegistry from '~/src/json/character-links.json'
import characterSnapshot from '~/src/json/characters.json'

export const prerender = true

const listings = await getHomepageListings()
const characterIndex = buildCharacterTimelineIndex( characterRegistry as CharacterRegistry, characterSnapshot as CharacterSnapshot, listings )

---
<Layout>

	
	<ListingRow 
		client:load
		listings={ convertNullValuesForAstro( listings ) }
		character-index={ characterIndex }
		is-global-list
	/>
	
  
	<script is:inline define:vars={{ timelineStateStorageKey }}>
		const initialListing = document.querySelector('.listing-card-initial')
		const row = document.querySelector('.listing-row')
		let restoredPosition = null

		if (!new URLSearchParams(window.location.search).has('personagem')) {
			try {
				const savedState = JSON.parse(window.localStorage.getItem(timelineStateStorageKey) || 'null')
				if (Number.isFinite(savedState?.scrollLeft) && savedState.scrollLeft >= 0) {
					restoredPosition = savedState.scrollLeft
				}
			} catch {}
		}

		if (row && restoredPosition !== null) {
			row.scrollLeft = restoredPosition
		} else if (row && initialListing) {
			row.scrollLeft = initialListing.offsetLeft - window.innerWidth + initialListing.offsetWidth * 1.75
		}
	</script>
</Layout>
